# Copy to .env and fill in. Load it with:  set -a; source .env; set +a

# --- required ---
GLEE_API_KEY=glee_your_key_here        # glee-competition.com/dashboard (shown once)

# --- LLM layer (only read when GLEE_LLM_MODE is not "off") ---
GLEE_LLM_MODE=messages                 # off | messages | full
LLM_MODEL=gemini/gemini-2.5-flash      # any litellm model string
# LLM_MODEL=claude-sonnet-5
# LLM_MODEL=gpt-5-mini
GEMINI_API_KEY=                        # whichever key LLM_MODEL needs
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
GLEE_LLM_MAX_CALLS=0                   # hard spend cap; 0 = unlimited
GLEE_LLM_TIMEOUT=25                    # seconds; the turn clock is 120

# --- run loop ---
GLEE_CONCURRENCY=6                     # 4-10; server allows 60 requests/minute
GLEE_POLL_INTERVAL=2.0
GLEE_FAMILIES=bargaining,negotiation,persuasion
# GLEE_MAX_GAMES=
# GLEE_MAX_TIME=

# --- strategy knobs ---
GLEE_BARG_SPE_WEIGHT=0.65              # 1.0 = full equilibrium, 0.0 = even split
GLEE_BARG_UNKNOWN_DELTA=0.90
GLEE_NEGO_SELLER_ANCHOR=2.20
GLEE_NEGO_BUYER_ANCHOR=0.45
GLEE_NEGO_HORIZON=10
GLEE_PERS_LIE_SHADING=0.80
GLEE_PERS_HONEST_ROUNDS=2

GLEE_LOG_DIR=logs
